// Sistem Informasi Klinik — Prisma schema (MySQL 8)
// Konvensi: model PascalCase, kolom camelCase, tabel/kolom MySQL snake_case lewat @@map/@map.
// Tiap modul menambah modelnya di blok bertanda di bawah agar konflik merge minim.
// Ringkasan tabel: docs/DATABASE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM DASAR (Rangga)
// ============================================================

enum Role {
  ADMIN
  DOCTOR
  STAFF
  PATIENT
}

enum StaffType {
  REGISTRATION
  PHARMACY
  CASHIER
}

enum Gender {
  MALE
  FEMALE
}

enum Relationship {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum BloodType {
  A
  B
  AB
  O
}

// ============================================================
// AUTH & AKUN (Rangga)
// ============================================================

model User {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(120)
  email           String     @unique @db.VarChar(191)
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  role            Role       @default(PATIENT)
  /// Wajib bila role = STAFF (divalidasi di features/users/service.ts)
  staffType       StaffType? @map("staff_type")
  isActive        Boolean    @default(true) @map("is_active")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  patients            Patient[]
  passwordResetTokens PasswordResetToken[]
  doctorAppointments  Appointment[]        @relation("DoctorAppointments")
  doctorRecords       MedicalRecord[]      @relation("DoctorRecords")

  @@index([role])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Penghitung atomik (mis. nomor rekam medis per tahun: key "rm-2026").
model Counter {
  key   String @id @db.VarChar(64)
  value Int    @default(0)

  @@map("counters")
}

// ============================================================
// PASIEN & AKUN KELUARGA (Rangga)
// Satu baris = satu orang pasien dengan rekam medis & QR sendiri.
// allergies & specialConditions dipakai fitur Red Flag modul dokter (Ravy).
// ============================================================

model Patient {
  id                  String       @id @default(cuid())
  accountUserId       String       @map("account_user_id")
  /// Format RM-YYYY-000001, digenerate di features/patients/service.ts
  medicalRecordNumber String       @unique @map("medical_record_number") @db.VarChar(20)
  nik                 String?      @unique @db.Char(16)
  name                String       @db.VarChar(120)
  birthDate           DateTime     @map("birth_date") @db.Date
  gender              Gender
  bloodType           BloodType?   @map("blood_type")
  phone               String?      @db.VarChar(20)
  address             String?      @db.Text
  relationship        Relationship
  allergies           String?      @db.Text
  specialConditions   String?      @map("special_conditions") @db.Text
  /// Token unik untuk QR Code pasien (gambar QR dirender di Tahap 4)
  qrToken             String       @unique @map("qr_token") @db.VarChar(64)
  isSelf              Boolean      @default(false) @map("is_self")
  deletedAt           DateTime?    @map("deleted_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  account User @relation(fields: [accountUserId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@index([accountUserId])
  @@index([name])
  @@map("patients")
}

// ============================================================
// JADWAL, APPOINTMENT, ANTREAN (Rangga — Tahap 3 & 4)
// ============================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  doctorId        String            @map("doctor_id")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  startTime       String            @map("start_time") @db.VarChar(5)
  endTime         String            @map("end_time") @db.VarChar(5)
  queueNumber     Int               @map("queue_number")
  status          AppointmentStatus @default(PENDING)
  chiefComplaint  String?           @map("chief_complaint") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  histories       AppointmentHistory[]
  medicalRecord   MedicalRecord?

  @@index([patientId])
  @@index([doctorId, appointmentDate])
  @@map("appointments")
}

model AppointmentHistory {
  id              String            @id @default(cuid())
  appointmentId   String            @map("appointment_id")
  status          AppointmentStatus
  notes           String?           @db.Text
  changedByUserId String?           @map("changed_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  appointment     Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_histories")
}

// ============================================================
// REKAM MEDIS (Ravy)
// ============================================================

model MedicalRecord {
  pharmacyStatus PharmacyStatus @default(WAITING) @map("pharmacy_status")
  pharmacyReceivedAt DateTime? @map("pharmacy_received_at")
  pharmacyReadyAt DateTime? @map("pharmacy_ready_at")
  pharmacyDispensedAt DateTime? @map("pharmacy_dispensed_at")
  pharmacyDispensedBy String? @map("pharmacy_dispensed_by")
  id              String             @id @default(cuid())
  appointmentId   String             @unique @map("appointment_id")
  patientId       String             @map("patient_id")
  doctorId        String             @map("doctor_id")
  subjective      String?            @db.Text
  objective       String?            @db.Text
  assessment      String?            @db.Text
  plan            String?            @db.Text
  bloodPressure   String?            @map("blood_pressure") @db.VarChar(20)
  bodyTemperature Float?             @map("body_temperature")
  bodyWeight      Float?             @map("body_weight")
  pulseRate       Int?               @map("pulse_rate")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          User               @relation("DoctorRecords", fields: [doctorId], references: [id])
  prescriptions   PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@map("medical_records")
}

// ============================================================
// OBAT, FARMASI, KASIR (Axel)
// ============================================================

model Medicine {
  id          String             @id @default(cuid())
  code        String             @unique @db.VarChar(50)
  name        String             @db.VarChar(150)
  category    String?            @db.VarChar(100)
  dosageForm  String             @map("dosage_form") @db.VarChar(50)
  unit        String             @db.VarChar(50)
  stock       Int                @default(0)
  price       Decimal            @db.Decimal(12, 2)
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  prescriptionItems PrescriptionItem[]

  @@map("medicines")
}

model PrescriptionItem {
  id                 String        @id @default(cuid())
  medicalRecordId    String        @map("medical_record_id")
  medicineId         String        @map("medicine_id")
  quantity           Int
  dosageInstructions String        @map("dosage_instructions") @db.VarChar(255)
  notes              String?       @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")

  medicalRecord      MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  medicine           Medicine      @relation(fields: [medicineId], references: [id])

  @@index([medicalRecordId])
  @@index([medicineId])
  @@map("prescription_items")
}


enum PharmacyStatus {
  WAITING
  PROCESSING
  READY
  DISPENSED
}
