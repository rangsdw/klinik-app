# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Database MySQL 8 (buat database klinik_app dengan utf8mb4 / utf8mb4_unicode_ci)
DATABASE_URL="mysql://root:@localhost:3306/klinik_app"

# Auth.js — generate dengan: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Identitas klinik (ditampilkan di seluruh aplikasi)
CLINIC_NAME="Klinik Sehat"
CLINIC_ADDRESS="Jl. Contoh No. 1, Kota"
CLINIC_PHONE="021-0000000"
CLINIC_EMAIL="halo@kliniksehat.test"
CLINIC_HOURS="Senin sampai Sabtu, 08.00 sampai 20.00"

# Email (kosongkan SMTP_HOST agar email dicetak ke console saat lokal)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Klinik Sehat <no-reply@kliniksehat.test>"

# Verifikasi email saat registrasi (default mati agar demo lancar)
EMAIL_VERIFICATION_ENABLED="false"
